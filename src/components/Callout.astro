---
import type { Hue } from '@/data/site';
interface Props { title: string; hue?: Hue }
const { title, hue = 'red' } = Astro.props;
---
<aside data-hue={hue} class="callout my-8">
  <h3 class="text-xl" style="color:var(--hue)">{title}</h3>
  <div class="mt-3 prose-site"><slot /></div>
</aside>
<style>
  .callout { position: relative; padding: 1.25rem; padding-inline-start: 1.5rem; border-block: 1px solid var(--line); border-inline-end: 1px solid var(--line); border-inline-start: 0.35rem solid var(--hue-vivid); background: var(--hue-soft); }
  @media (min-width: 48rem) { .callout { padding: 1.75rem 2rem; } }
</style>
