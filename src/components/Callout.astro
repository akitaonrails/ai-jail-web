---
// Limits and caveats: a block on the subject's plate with a stamp-like heading. Red by default.
import type { Hue } from '@/data/site';
interface Props { title: string; hue?: Hue }
const { title, hue = 'red' } = Astro.props;
---
<aside data-hue={hue} class="cell my-8">
  <h3 class="text-xl flex items-center gap-3"><span class="bars shrink-0" aria-hidden="true"><i></i></span><span>{title}</span></h3>
  <div class="mt-3 prose-site"><slot /></div>
</aside>
