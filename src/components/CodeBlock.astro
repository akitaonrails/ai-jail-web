---
// A terminal with a copy button. Lines starting with "#" dim as comments. Always ink, always left to right.
import { useI18n } from '@/i18n';
interface Props { code: string; title?: string }
const { code, title = 'terminal' } = Astro.props;
const { t } = useI18n(Astro);
const lines = code.trim().split('\n');
---
<div class="term on-ink" dir="ltr" data-code>
  <div class="term-bar">
    <span class="bars !block-size-3.5 !gap-1" aria-hidden="true"><i></i></span>
    <span class="text-sm font-mono" style="color:var(--on-ink-muted)">{title}</span>
    <button type="button" class="ms-auto text-sm font-mono font-bold hover:underline" data-copy><span data-copy-label data-copied={t('code.copied')}>{t('code.copy')}</span></button>
  </div>
  <pre><code>{lines.map((l) => <span class:list={['block', l.trimStart().startsWith('#') && 'c']}>{l || ' '}</span>)}</code></pre>
</div>
<style is:global>
  .term { border: var(--rule) solid var(--line); box-shadow: var(--press); overflow: hidden; text-align: left; }
  .term-bar { display: flex; align-items: center; gap: 0.7rem; padding: 0.55rem 1rem; background: var(--ink-raised); border-block-end: 1.5px solid var(--ink-line); }
  .term-bar .bars::before, .term-bar .bars::after, .term-bar .bars > i { background: var(--on-ink); }
  .term pre { padding: 1rem 1.2rem; overflow-x: auto; font-size: 0.95rem; line-height: 1.65; }
  .term .c { color: var(--on-ink-muted); }
</style>
