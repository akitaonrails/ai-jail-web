---
import { useI18n } from '@/i18n';
interface Props { code: string; title?: string }
const { code, title: titleProp } = Astro.props;
const { t } = useI18n(Astro);
const title = titleProp ?? t('code.terminal');
const lines = code.trim().split('\n');
---
<div class="term on-ink" dir="ltr" data-code>
  <div class="term-bar">
    <span class="bars !block-size-3.5 !gap-1" aria-hidden="true"><i></i></span>
    <span class="text-sm" style="color:var(--on-ink-muted)">{title}</span>
    <button type="button" class="ms-auto text-sm font-semibold hover:underline" data-copy><span data-copy-label data-copied={t('code.copied')}>{t('code.copy')}</span></button>
  </div>
  <pre tabindex="0" role="group" aria-label={title}><code>{lines.map((l) => <span class:list={['block', l.trimStart().startsWith('#') && 'c']}>{l || ' '}</span>)}</code></pre>
</div>
<style is:global>
  .term { border-radius: 0.2rem; border: 1.5px solid var(--ink-line); border-inline-start: 0.3rem solid var(--v-cyan); overflow: hidden; text-align: left; }
  .term-bar { display: flex; align-items: center; gap: 0.7rem; padding: 0.55rem 0.8rem; background: var(--ink-raised); border-block-end: 1px solid var(--ink-line); font-family: var(--font-mono); }
  .term pre { padding: 1rem; overflow-x: auto; font-size: 0.93rem; line-height: 1.7; }
  .term pre:focus-visible { outline-offset: -3px; }
  .term .c { color: var(--on-ink-muted); }
</style>
