---
// The closing call to action, printed in ink. The one centered thing on the site.
import CodeBlock from './CodeBlock.astro';
import { site } from '@/data/site';
import { useI18n } from '@/i18n';
interface Props { title?: string; text?: string }
const { t, href } = useI18n(Astro);
const { title = t('cta.title'), text = t('cta.text') } = Astro.props;
---
<section class="on-ink band text-center cta">
  <div class="wrap-narrow">
    <h2 class="text-3xl mx-auto max-w-[16em]">{title}</h2>
    <p class="lede mx-auto mt-5">{text}</p>
    <div class="mt-8 max-w-xl mx-auto"><CodeBlock code={'brew tap akitaonrails/tap && brew install ai-jail\nai-jail claude'} /></div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={href('/install/')} class="btn btn-primary">{t('cta.install')}</a>
      <a href={site.repo} class="btn btn-ghost">{t('cta.github')}</a>
    </div>
  </div>
</section>
<style>
  .cta { border-block-start: var(--rule) solid var(--line); }
  .cta :global(.term) { box-shadow: var(--offset) var(--offset) 0 var(--v-teal); border-color: var(--on-ink); }
</style>
