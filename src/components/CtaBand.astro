---
// The cinematic closing call to action. The one centered section on the site.
import CodeBlock from './CodeBlock.astro';
import { site } from '@/data/site';
import { useI18n } from '@/i18n';
interface Props { title?: string; text?: string }
const { t, href } = useI18n(Astro);
const { title = t('cta.title'), text = t('cta.text') } = Astro.props;
---
<section class="on-ink band text-center cta" data-hue="teal">
  <div class="wrap-narrow">
    <h2 class="text-3xl mx-auto max-w-[16em]">{title}</h2>
    <p class="lede mx-auto mt-5">{text}</p>
    <div class="mt-8 max-w-xl mx-auto"><CodeBlock code={'brew tap akitaonrails/tap && brew install ai-jail\nai-jail claude'} /></div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={href('/install/')} class="btn btn-primary">{t('cta.install')}</a>
      <a href={site.repo} class="btn btn-ghost">{t('cta.github')}</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; isolation: isolate; min-block-size: 72svh; display: grid; align-items: center; border-block-start: var(--rule) solid var(--line); overflow: hidden; }
  .cta::before { content: ''; position: absolute; inset: 0; z-index: -2; background-image: var(--fortress-image); background-position: center; background-size: cover; opacity: 0.46; }
  .cta::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(color-mix(in oklch, var(--ink) 78%, transparent), color-mix(in oklch, var(--ink) 96%, transparent)); }
  .cta :global(.term) { box-shadow: none; border-color: color-mix(in oklch, var(--teal) 55%, transparent); }
</style>
