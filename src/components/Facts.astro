---
// A strip of verified numbers, each under a rule in the subject's color. Numbers come from src/data/facts.json,
// never typed into a page. Labels accept inline HTML.
import { useI18n } from '@/i18n';
interface Item { n: number; label: string; count?: boolean }
interface Props { items: Item[] }
const { items } = Astro.props;
const { number } = useI18n(Astro);
---
<dl class="facts" style={`--cols:${items.length}`}>
  {items.map((f) => (
    <div>
      <dd class="text-4xl">{number(f.n)}</dd>
      <dt set:html={f.label} />
    </div>
  ))}
</dl>
<style>
  .facts { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 48rem) { .facts { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  .facts > div { display: flex; flex-direction: column; border-block-start: var(--rule) solid var(--line); padding-block-start: 0.8rem; }
  .facts > div::before { content: ''; display: block; inline-size: 3rem; block-size: 0.5rem; background: var(--hue-vivid, var(--text)); margin-block-end: 0.8rem; }
  .facts dd { font-family: var(--font-display); color: var(--text); line-height: 1; font-variant-numeric: tabular-nums; }
  .facts dt { margin-block-start: 0.6rem; color: var(--muted); }
</style>
