---
interface Item { n: number; label: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<dl class="facts" style={`--cols:${items.length}`}>
  {items.map((f) => (
    <div>
      <dd class="text-4xl">{f.n}</dd>
      <dt set:html={f.label} />
    </div>
  ))}
</dl>
<style>
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block-start: 1px solid var(--line); border-inline-start: 1px solid var(--line); }
  @media (min-width: 48rem) { .facts { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  .facts > div { display: flex; flex-direction: column; min-block-size: 10rem; padding: 1.25rem; border-inline-end: 1px solid var(--line); border-block-end: 1px solid var(--line); background: var(--surface); }
  .facts dd { font-family: var(--font-mono); font-weight: 700; color: var(--hue); line-height: 1; font-variant-numeric: tabular-nums; }
  .facts dt { margin-block-start: auto; padding-block-start: 1.5rem; color: var(--muted); }
</style>
