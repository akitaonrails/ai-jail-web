---
// Two to six short points, each printed as a cell in its subject's color. An item with href is clickable.
import type { Hue } from '@/data/site';
import { useI18n } from '@/i18n';
interface Item { title: string; text: string; hue?: Hue; href?: string; link?: string }
interface Props { items: Item[]; cols?: 2 | 3 }
const { items, cols = 3 } = Astro.props;
const { href } = useI18n(Astro);
---
<div class:list={['grid gap-6', cols === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
  {items.map((it) => it.href ? (
    <a href={href(it.href)} data-hue={it.hue} class="cell">
      <span class="bars mb-3" aria-hidden="true"><i></i></span>
      <h3 class="text-xl" set:html={it.title} />
      <p class="mt-2" set:html={it.text} />
      {it.link && <span class="mt-4 inline-block font-mono font-bold underline underline-offset-4">{it.link}</span>}
    </a>
  ) : (
    <div data-hue={it.hue} class="cell">
      <span class="bars mb-3" aria-hidden="true"><i></i></span>
      <h3 class="text-xl" set:html={it.title} />
      <p class="mt-2" set:html={it.text} />
    </div>
  ))}
</div>
