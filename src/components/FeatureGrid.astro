---
import type { Hue } from '@/data/site';
import { useI18n } from '@/i18n';
interface Item { title: string; text: string; hue?: Hue; href?: string; link?: string }
interface Props { items: Item[]; cols?: 2 | 3 }
const { items, cols = 3 } = Astro.props;
const { href, number } = useI18n(Astro);
---
<div class:list={['feature-grid', cols === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
  {items.map((it, i) => it.href ? (
    <a href={href(it.href)} data-hue={it.hue} class="feature-record">
      <span class="feature-index" aria-hidden="true">{number(i + 1, { minimumIntegerDigits: 2, useGrouping: false })}</span>
      <h3 class="text-xl" set:html={it.title} />
      <p class="mt-2 text-muted" set:html={it.text} />
      {it.link && <span class="mt-4 inline-block font-semibold" style="color:var(--hue)">{it.link}</span>}
    </a>
  ) : (
    <div data-hue={it.hue} class="feature-record">
      <span class="feature-index" aria-hidden="true">{number(i + 1, { minimumIntegerDigits: 2, useGrouping: false })}</span>
      <h3 class="text-xl" set:html={it.title} />
      <p class="mt-2 text-muted" set:html={it.text} />
    </div>
  ))}
</div>
<style>
  .feature-grid { display: grid; border-block-start: 1px solid var(--line); border-inline-start: 1px solid var(--line); }
  .feature-record { display: block; position: relative; padding: 1.5rem; border-inline-end: 1px solid var(--line); border-block-end: 1px solid var(--line); background: var(--surface); }
  a.feature-record { transition: background-color 0.15s, border-color 0.15s; }
  a.feature-record:hover { background: var(--hue-soft, var(--tint)); border-block-start-color: var(--hue-vivid, var(--text)); }
  .feature-index { display: block; margin-block-end: 1.5rem; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 700; color: var(--hue, var(--muted)); font-variant-numeric: tabular-nums; }
</style>
