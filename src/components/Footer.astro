---
import { Image } from 'astro:assets';
import logo from '@/assets/img/logo.png';
import { nav, site } from '@/data/site';
import facts from '@/data/facts.json';
import { useI18n, languageLinks } from '@/i18n';
const { t, href, locale } = useI18n(Astro);
const languages = languageLinks(Astro.url.pathname);
---
<footer class="border-t border-line">
  <div class="spectrum-rule !rounded-none" aria-hidden="true"></div>
  <div class="wrap py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href={href('/')} class="inline-flex items-center gap-2">
        <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} class="size-11" />
        <span class="font-display text-2xl font-extrabold tracking-tight">ai-jail</span>
      </a>
      <p class="mt-3 text-muted max-w-[26em]">{t('site.tagline')}</p>
      <p class="mt-3 text-sm text-muted">{t('footer.version', { version: facts.version, license: facts.license })}</p>
    </div>
    <nav aria-label={t('footer.pages')} class="grid gap-2 content-start">
      {[...nav, { id: 'install', href: '/install/' }].map((l) => <a href={href(l.href)} class="hover:text-text text-muted">{t(`nav.${l.id}.label`)}</a>)}
    </nav>
    <div class="grid gap-2 content-start">
      <a href={site.repo} class="hover:text-text text-muted">GitHub</a>
      <a href={`${site.repo}/releases`} class="hover:text-text text-muted">{t('footer.releases')}</a>
      <a href={`${site.repo}/security/advisories/new`} class="hover:text-text text-muted">{t('footer.report')}</a>
      <a href={site.sibling} class="hover:text-text text-muted">{t('footer.sibling')}</a>
    </div>
  </div>
  <div class="wrap pb-10 flex flex-wrap gap-x-6 gap-y-3 items-center text-sm text-muted">
    <span>{t('footer.by')} <a class="link" href={site.authorUrl}>{site.author}</a></span>
    <span class="flex flex-wrap gap-x-3 gap-y-1">
      {languages.map((l) => <a href={l.url} hreflang={l.htmlLang} lang={l.htmlLang} data-set-lang={l.code} class:list={['hover:text-text', l.code === locale && 'text-text font-semibold']}>{l.label}</a>)}
    </span>
    <span class="flex gap-1 ms-auto" role="group" aria-label={t('a11y.toggleTheme')}>
      {(['system', 'light', 'dark'] as const).map((m) => <button type="button" class="pick" data-theme-set={m}>{t(`footer.theme.${m}`)}</button>)}
    </span>
  </div>
</footer>
<style is:global>
  .pick { padding: 0.25rem 0.75rem; border-radius: 99px; border: 1.5px solid var(--line); font-weight: 600; font-size: var(--text-sm); color: var(--muted); }
  .pick:hover { color: var(--text); }
  .pick[aria-pressed='true'], .pick[aria-selected='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
</style>
