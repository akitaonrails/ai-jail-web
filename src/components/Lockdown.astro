---
// A guided procession through the boundary. Every step gets its own visual field; the final map summarizes the result.
import { useI18n } from '@/i18n';
const { t, raw } = useI18n(Astro, 'home');
const steps = raw<{ title: string; text: string }[]>('scene.steps');
const tiles = [
  { label: '~/.ssh', state: 'blocked' }, { label: '~/.aws', state: 'blocked' }, { label: t('scene.tiles.projects'), state: 'blocked' },
  { label: '$GITHUB_TOKEN', state: 'blocked' }, null, { label: t('scene.tiles.network'), state: 'optin' },
  { label: 'docker.sock', state: 'blocked' }, { label: t('scene.tiles.display'), state: 'blocked' }, { label: '~/.claude', state: 'inside' },
];
---
<section class="procession" aria-label={t('scene.label')}>
  <div class="wrap-narrow">
    <ol class="procession-steps">
      {steps.map((step, index) => (
        <li class="procession-step" data-hue={index === steps.length - 1 ? 'mustard' : 'teal'}>
          <span class="procession-node font-mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div class="procession-copy">
            <h2 class="text-3xl">{step.title}</h2>
            <p class="lede" set:html={step.text} />
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class="boundary-stage on-ink">
    <div class="wrap">
      <div class="boundary-map" dir="ltr" aria-hidden="true">
        {tiles.map((tile) => tile ? (
          <div class="boundary-tile" data-state={tile.state}><span>{tile.label}</span></div>
        ) : (
          <div class="boundary-tile project">
            <span class="agent-chip">{t('scene.agent')}</span>
            <strong>{t('scene.project')}</strong>
            <span class="cellbars"><i></i><i></i><i></i><i></i></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .procession { position: relative; border-block: var(--rule) solid color-mix(in oklch, var(--line) 48%, transparent); }
  .procession-steps { position: relative; padding-block: clamp(5rem, 10vw, 9rem); }
  .procession-steps::before { content: ''; position: absolute; inset-block: clamp(5rem, 10vw, 9rem); inset-inline-start: 2rem; inline-size: 1px; background: linear-gradient(var(--teal), var(--red)); }
  .procession-step { min-block-size: min(68svh, 42rem); display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  .procession-node { position: relative; z-index: 1; inline-size: 4rem; block-size: 4rem; display: grid; place-items: center; color: var(--hue); background: var(--bg); border: var(--rule) solid var(--hue); }
  .procession-copy { max-inline-size: 43rem; }
  .procession-copy h2 { margin-block-end: 1.5rem; }
  .boundary-stage { padding-block: clamp(5rem, 10vw, 9rem); border-block-start: var(--rule) solid var(--line); background-image: linear-gradient(90deg, color-mix(in oklch, var(--ink) 96%, transparent), color-mix(in oklch, var(--ink) 74%, transparent)), var(--hero-image); background-size: cover; background-position: center; }
  .boundary-map { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.65rem, 1.6vw, 1.15rem); max-inline-size: 48rem; margin-inline: auto; }
  .boundary-tile { position: relative; aspect-ratio: 1; display: grid; place-content: center; justify-items: center; gap: 0.6rem; padding: 0.7rem; text-align: center; border: var(--rule) solid var(--line); background: var(--surface); color: var(--text); font-family: var(--font-mono); font-weight: 700; font-size: clamp(0.72rem, 1.5vw, 0.94rem); overflow-wrap: anywhere; }
  .boundary-tile[data-state='blocked'] { background: repeating-linear-gradient(45deg, var(--surface) 0 7px, color-mix(in oklch, var(--v-red) 62%, var(--surface)) 7px 9px); }
  .boundary-tile[data-state='blocked'] > span { background: var(--surface); padding: 0.2em 0.45em; }
  .boundary-tile[data-state='optin'] { color: var(--ink); background: var(--v-mustard); }
  .boundary-tile[data-state='inside'], .boundary-tile.project { color: var(--ink); background: var(--v-teal); }
  .boundary-tile.project { font-family: var(--font-display); }
  .agent-chip { display: grid; place-items: center; inline-size: clamp(2.7rem, 7vw, 4.2rem); aspect-ratio: 1; border: var(--rule) solid var(--ink); background: var(--ink); color: var(--on-ink); font-family: var(--font-mono); font-size: 0.75em; }
  .cellbars { position: absolute; inset: 0; display: flex; justify-content: space-evenly; pointer-events: none; }
  .cellbars i { inline-size: 2px; block-size: 100%; background: var(--ink); }
  @media (max-width: 40rem) {
    .procession-steps::before { inset-inline-start: 1.5rem; }
    .procession-step { min-block-size: 74svh; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.5rem; }
    .procession-node { inline-size: 3rem; block-size: 3rem; }
    .boundary-map { gap: 0.45rem; }
    .boundary-tile { padding: 0.35rem; font-size: 0.64rem; }
  }
</style>
