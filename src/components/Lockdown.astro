---
// The homepage scroll scene: what the agent can reach, before and after. The section is tall and its stage is
// sticky; motion.ts only writes data-step="0..4" from the scroll position and the CSS below does everything else.
// Without JavaScript or with reduced motion there is no data-step: the stage shows the final state and the
// captions stack as a normal list.
import { useI18n } from '@/i18n';
const { t, raw } = useI18n(Astro, 'home');
const steps = raw<{ title: string; text: string }[]>('scene.steps');
// `off` is the step at which the tile gets barred; `optin` tiles come back on the mustard plate at the last step; an
// `inside` tile (the agent's own login, mounted by default) stays reachable on the teal plate at every step.
const tiles = [
  { label: '~/.ssh', off: 2 }, { label: '~/.aws', off: 2 }, { label: t('scene.tiles.projects'), off: 2 },
  { label: '$GITHUB_TOKEN', off: 3 }, null, { label: t('scene.tiles.network'), off: 3, optin: true },
  { label: 'docker.sock', off: 3 }, { label: t('scene.tiles.display'), off: 3 }, { label: '~/.claude', inside: true },
];
---
<section class="scene bg-tint" data-scene={steps.length} aria-label={t('scene.label')}>
  <div class="stage">
    <div class="wrap grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-16 items-center">
      <ol class="caps">
        {steps.map((s, i) => (
          <li class="cap" data-i={i}>
            <h2 class="text-3xl">{s.title}</h2>
            <p class="mt-4 text-lg max-w-[30em]" set:html={s.text} />
          </li>
        ))}
      </ol>
      <div class="map" dir="ltr" aria-hidden="true">
        {tiles.map((tile) => tile ? (
          <div class="tile" data-off={tile.off} data-optin={tile.optin ? '' : undefined} data-inside={tile.inside ? '' : undefined}><span>{tile.label}</span></div>
        ) : (
          <div class="tile project">
            <span class="chip"><span>{t('scene.agent')}</span></span>
            <span>{t('scene.project')}</span>
            <span class="cellbars"><i></i><i></i><i></i><i></i></span>
          </div>
        ))}
      </div>
    </div>
    <div class="progress" aria-hidden="true"><span data-scene-progress></span></div>
  </div>
</section>

<style>
  .scene { position: relative; border-block: var(--rule) solid var(--line); }
  .stage { padding-block: clamp(4rem, 9vw, 7rem); }
  .caps { display: grid; gap: 2.5rem; }
  .progress { display: none; }

  .map { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.6rem, 1.6vw, 1.1rem); max-inline-size: 36rem; inline-size: 100%; margin-inline: auto; }
  .tile { position: relative; aspect-ratio: 1; display: grid; place-content: center; justify-items: center; gap: 0.5rem; padding: 0.4rem; text-align: center; border: var(--rule) solid var(--line); box-shadow: var(--press); background: var(--surface); color: var(--text); font-family: var(--font-mono); font-weight: 700; font-size: clamp(0.68rem, 1.5vw, 0.9rem); overflow-wrap: anywhere; transition: background 0.5s, color 0.5s; }
  .tile > span { position: relative; z-index: 1; }
  /* Final state, which is also the no-script state: everything barred, opt-ins mustard, project inside. */
  .tile:not(.project) { background: repeating-linear-gradient(45deg, var(--surface) 0 5px, var(--v-red) 5px 7px); }
  .tile:not(.project) > span { background: var(--surface); padding: 0.15em 0.4em; outline: 1.5px solid var(--line); }
  .tile[data-optin] { background: var(--v-mustard); color: var(--ink); }
  .tile[data-optin] > span { background: none; outline: 0; }
  /* An inside tile is reachable throughout: the same teal as the project, at every step, never barred. */
  .tile[data-inside], .scene[data-step] .tile[data-inside]:not(.project) { background: var(--v-teal); color: var(--ink); }
  .tile[data-inside] > span { background: none; outline: 0; }
  .project { background: var(--v-teal); color: var(--ink); font-family: var(--font-display); font-weight: 400; text-transform: uppercase; }
  .chip { display: grid; place-items: center; inline-size: clamp(2.6rem, 7vw, 4rem); aspect-ratio: 1; border: var(--rule) solid var(--line); background: var(--surface); color: var(--text); font-family: var(--font-mono); font-size: 0.7em; font-weight: 700; text-transform: none; }
  .cellbars { position: absolute; inset: 0; display: flex; justify-content: space-evenly; pointer-events: none; z-index: 2; }
  .cellbars i { inline-size: 5px; block-size: 100%; background: var(--line); transform-origin: top; transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cellbars i:nth-child(2) { transition-delay: 0.08s; } .cellbars i:nth-child(3) { transition-delay: 0.16s; } .cellbars i:nth-child(4) { transition-delay: 0.24s; }

  /* Scroll-driven version. */
  .scene[data-step] { block-size: 520vh; }
  .scene[data-step] .stage { position: sticky; inset-block-start: 0; block-size: 100dvh; display: grid; align-content: center; padding-block: 5rem 2rem; overflow: hidden; }
  .scene[data-step] .caps { display: grid; gap: 0; }
  .scene[data-step] .cap { grid-area: 1 / 1; opacity: 0; transform: translateY(1rem); transition: opacity 0.4s, transform 0.4s; pointer-events: none; }
  .scene[data-step='0'] .cap[data-i='0'], .scene[data-step='1'] .cap[data-i='1'], .scene[data-step='2'] .cap[data-i='2'],
  .scene[data-step='3'] .cap[data-i='3'], .scene[data-step='4'] .cap[data-i='4'] { opacity: 1; transform: none; pointer-events: auto; }
  .scene[data-step] .progress { display: block; position: absolute; inset-inline: 0; inset-block-end: 0; block-size: 5px; }
  .progress span { display: block; block-size: 100%; background: var(--line); transform: scaleX(0); transform-origin: left; }

  /* A tile is "lit" (reachable, on the clay plate) until the scroll reaches its data-off step. */
  .scene[data-step='0'] .tile:not(.project), .scene[data-step='1'] .tile:not(.project),
  .scene[data-step='2'] .tile[data-off='3'] { background: var(--v-clay); color: var(--ink); }
  .scene[data-step='0'] .tile:not(.project) > span, .scene[data-step='1'] .tile:not(.project) > span, .scene[data-step='2'] .tile[data-off='3'] > span { background: none; outline: 0; }
  /* Opt-ins are barred like the rest until the last step. */
  .scene[data-step='2'] .tile[data-optin][data-off='2'], .scene[data-step='3'] .tile[data-optin] { color: var(--text); background: repeating-linear-gradient(45deg, var(--surface) 0 5px, var(--v-red) 5px 7px); }
  .scene[data-step='2'] .tile[data-optin][data-off='2'] > span, .scene[data-step='3'] .tile[data-optin] > span { background: var(--surface); outline: 1.5px solid var(--line); }
  .scene[data-step='0'] .project { background: var(--v-clay); }
  .scene[data-step='0'] .cellbars i { transform: scaleY(0); }

  @media (max-width: 63.99rem) {
    .scene[data-step] .stage { align-content: start; padding-block-start: 5.5rem; }
    .scene[data-step] .cap h2 { font-size: var(--text-2xl); }
    .scene[data-step] .cap p { font-size: 1rem; margin-block-start: 0.6rem; }
    .scene[data-step] .caps { min-block-size: 15.5rem; }
    .map { max-inline-size: min(22rem, 46dvh); }
  }
</style>
