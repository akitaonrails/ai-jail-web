---
import { useI18n } from '@/i18n';
const { t, raw } = useI18n(Astro, 'home');
const steps = raw<{ title: string; text: string }[]>('scene.steps');
type Row = { label: string; state: 'inside' | 'blocked' | 'optin'; localized?: boolean; off?: number; optin?: boolean; inside?: boolean };
const rows: Row[] = [
  { label: '~/.ssh', state: 'blocked', off: 2 },
  { label: '~/.aws', state: 'blocked', off: 2 },
  { label: t('scene.tiles.projects'), state: 'blocked', localized: true, off: 2 },
  { label: '$GITHUB_TOKEN', state: 'blocked', off: 3 },
  { label: t('scene.tiles.network'), state: 'optin', localized: true, off: 3, optin: true },
  { label: 'docker.sock', state: 'blocked', off: 3 },
  { label: t('scene.tiles.display'), state: 'blocked', localized: true, off: 3 },
  { label: '~/.claude', state: 'inside', inside: true },
] as const;
---
<script>
  import '@/scripts/motion';
</script>
<section class="scene on-ink" data-scene={steps.length} aria-label={t('scene.label')}>
  <div class="stage">
    <div class="wrap stage-grid">
      <ol class="caps">
        {steps.map((step, i) => (
          <li class="cap" data-i={i}>
            <div>
              <h2 class="text-2xl">{step.title}</h2>
              <p class="mt-3 max-w-[34em]" set:html={step.text} />
            </div>
          </li>
        ))}
      </ol>
      <div class="ledger" dir="ltr">
        <div class="boundary">
          <div class="agent"><bdi dir="auto">{t('scene.agent')}</bdi><strong><bdi dir="auto">{t('scene.project')}</bdi></strong></div>
          <div class="rule"></div>
          <div class="records">
            {rows.map((row) => (
              <div class="record" data-off={row.off} data-optin={row.optin ? '' : undefined} data-inside={row.inside ? '' : undefined}>
                {row.localized ? <bdi dir="auto">{row.label}</bdi> : <span dir="ltr">{row.label}</span>}
                <i></i>
                <span class="sr-only"><bdi dir="auto">{t(`reach.${row.state}`)}</bdi></span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="progress" aria-hidden="true"><span data-scene-progress></span></div>
  </div>
</section>

<style>
  .scene { position: relative; }
  .stage { padding-block: clamp(4rem, 8vw, 6rem); }
  .stage-grid { display: grid; gap: clamp(3rem, 7vw, 6rem); align-items: start; }
  .caps { display: grid; border-block: 1px solid var(--ink-line); }
  .cap { display: grid; padding-block: 1.4rem; border-block-start: 1px solid var(--ink-line); }
  .cap:first-child { border-block-start: 0; }
  .cap p { color: var(--on-ink-muted); }
  .progress { display: none; }
  .ledger { inline-size: 100%; max-inline-size: 36rem; margin-inline: auto; font-family: var(--font-mono); font-size: clamp(0.72rem, 1.5vw, 0.9rem); }
  .boundary { border: 1.5px solid var(--v-red); }
  .agent { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: center; padding: 1rem; background: color-mix(in oklch, var(--v-cyan) 8%, var(--ink)); border-block-end: 1.5px solid var(--v-cyan); }
  .agent > bdi { display: grid; place-items: center; inline-size: 3rem; aspect-ratio: 1; border: 1.5px solid var(--v-cyan); color: var(--v-cyan); }
  .agent strong { color: var(--on-ink); font-family: var(--font-display); font-size: var(--text-lg); }
  .rule { block-size: 0.4rem; background: var(--spectrum); }
  .records { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .record { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 1rem; gap: 0.75rem; align-items: center; min-block-size: 3.2rem; padding: 0.7rem 0.8rem; border-block-start: 1px solid var(--ink-line); border-inline-end: 1px solid var(--ink-line); color: var(--on-ink-muted); overflow-wrap: anywhere; }
  .record:nth-child(even) { border-inline-end: 0; }
  .record i { inline-size: 1rem; block-size: 1rem; background: repeating-linear-gradient(90deg, var(--v-red) 0 0.18rem, transparent 0.18rem 0.4rem); }
  .record[data-optin] { color: var(--v-gold); }
  .record[data-optin] i { border: 0.3rem solid var(--v-gold); border-radius: 50%; background: var(--ink); }
  .record[data-inside], .scene[data-step] .record[data-inside] { color: var(--on-ink); background: color-mix(in oklch, var(--v-cyan) 8%, var(--ink)); }
  .record[data-inside] i, .scene[data-step] .record[data-inside] i { border: 0.3rem solid var(--v-cyan); border-radius: 50%; background: var(--ink); }

  @media (min-width: 64rem) {
    .stage-grid { grid-template-columns: minmax(0, 1fr) minmax(28rem, 1fr); align-items: center; }
  }

  @media (min-width: 64rem) and (min-height: 45rem) and (prefers-reduced-motion: no-preference) {
    .scene[data-step] { block-size: 300vh; }
    .scene[data-step] .stage { position: sticky; inset-block-start: 0; display: grid; align-content: center; min-block-size: 100dvh; padding-block: 5rem 2rem; }
    .scene[data-step] .caps { min-block-size: 18rem; border-block: 0; }
    .scene[data-step] .cap { grid-area: 1 / 1; align-self: center; border: 0; opacity: 0; transform: translateY(0.75rem); transition: opacity 0.25s, transform 0.25s; pointer-events: none; }
    .scene[data-step='0'] .cap[data-i='0'], .scene[data-step='1'] .cap[data-i='1'], .scene[data-step='2'] .cap[data-i='2'], .scene[data-step='3'] .cap[data-i='3'], .scene[data-step='4'] .cap[data-i='4'] { opacity: 1; transform: none; pointer-events: auto; }
    .scene[data-step] .progress { display: block; position: absolute; inset-inline: 0; inset-block-end: 0; block-size: 3px; }
    .progress span { display: block; block-size: 100%; background: var(--spectrum); transform: scaleX(0); transform-origin: left; }
    .scene[data-step='0'] .boundary { border-color: var(--v-gold); }
    .scene[data-step='0'] .agent { background: color-mix(in oklch, var(--v-orange) 10%, var(--ink)); border-color: var(--v-gold); }
    .scene[data-step='0'] .agent > bdi { border-color: var(--v-gold); color: var(--v-gold); }
    .scene[data-step='0'] .record:not([data-inside]), .scene[data-step='1'] .record:not([data-inside]), .scene[data-step='2'] .record[data-off='3']:not([data-inside]) { color: var(--on-ink); background: color-mix(in oklch, var(--v-orange) 10%, var(--ink)); }
    .scene[data-step='0'] .record:not([data-inside]) i, .scene[data-step='1'] .record:not([data-inside]) i, .scene[data-step='2'] .record[data-off='3']:not([data-inside]) i { border: 0.3rem solid var(--v-gold); border-radius: 50%; background: var(--ink); }
    .scene[data-step='2'] .record[data-optin][data-off='2'], .scene[data-step='3'] .record[data-optin] { color: var(--on-ink-muted); background: var(--ink); }
    .scene[data-step='2'] .record[data-optin][data-off='2'] i, .scene[data-step='3'] .record[data-optin] i { border: 0; border-radius: 0; background: repeating-linear-gradient(90deg, var(--v-red) 0 0.18rem, transparent 0.18rem 0.4rem); }
  }

  @media (max-width: 39.99rem) {
    .cap p { font-size: 0.95rem; line-height: 1.45; }
    .ledger { max-inline-size: 31rem; }
    .record { min-block-size: 2.6rem; padding: 0.45rem 0.55rem; }
    .agent { padding: 0.6rem; }
    .agent > bdi { inline-size: 2.4rem; }
  }
</style>
