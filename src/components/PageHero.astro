---
// Top of every detail page: one cinematic statement, a short explanation and the next action.
import type { Hue } from '@/data/site';
interface Props { hue: Hue; page?: 'why' | 'how' | 'compare' | 'configure' | 'security' | 'install' | 'download'; kicker: string; title: string; lede: string; audience?: string }
const { hue, page, kicker, title, lede, audience } = Astro.props;
---
<section data-hue={hue} data-page={page} class="page-hero on-ink">
  <div class="wrap page-hero-inner">
    <div class="hero-box">
      <div class="flex items-center gap-3 mb-5"><span class="bars" aria-hidden="true"><i></i></span><span class="kicker">{kicker}</span></div>
      <h1 class="text-4xl max-w-[12em]">{title}</h1>
      <p class="lede mt-7">{lede}</p>
      {audience && <p class="audience mt-4">{audience}</p>}
      {Astro.slots.has('default') && <div class="mt-8 flex flex-wrap gap-3"><slot /></div>}
      {page === 'how' && <svg class="rings" viewBox="0 0 200 200" aria-hidden="true"><rect x="4" y="4" width="192" height="192" /><rect x="28" y="28" width="144" height="144" /><rect x="52" y="52" width="96" height="96" /><rect x="76" y="76" width="48" height="48" /><rect x="92" y="92" width="16" height="16" class="core" /></svg>}
      {page === 'configure' && <svg class="switches" viewBox="0 0 320 24" aria-hidden="true">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <rect x={i * 40 + 2} y="2" width="20" height="20" class={i % 3 === 0 ? 'on' : undefined} />)}</svg>}
    </div>
  </div>
</section>
<style>
  .page-hero { position: relative; isolation: isolate; min-block-size: min(88svh, 58rem); display: grid; overflow: hidden; border-block-end: var(--rule) solid var(--line); background: var(--ink); }
  .page-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; background-image: var(--hero-image); background-size: cover; background-position: center; opacity: 0.74; }
  .page-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, color-mix(in oklch, var(--ink) 98%, transparent) 0%, color-mix(in oklch, var(--ink) 84%, transparent) 48%, color-mix(in oklch, var(--ink) 22%, transparent) 100%), linear-gradient(0deg, color-mix(in oklch, var(--ink) 92%, transparent), transparent 58%); }
  .page-hero-inner { display: grid; align-items: end; padding-block: clamp(10rem, 18vh, 14rem) clamp(5rem, 10vh, 8rem); }
  .hero-box { position: relative; max-inline-size: 54rem; }
  .hero-box::after { content: ''; position: absolute; inset-inline-start: 0; inset-block-end: -2.2rem; inline-size: clamp(7rem, 18vw, 15rem); block-size: 1px; background: linear-gradient(90deg, var(--hue), transparent); }
  .page-hero h1 { color: var(--on-ink); text-shadow: 0 0.4rem 2rem var(--ink); }
  .page-hero .lede { color: var(--on-ink-muted); font-size: clamp(1.08rem, 1rem + 0.45vw, 1.35rem); }
  .audience { font-family: var(--font-mono); font-weight: 700; font-size: var(--text-sm); color: var(--on-ink-muted); max-width: 44em; }
  .rings { position: absolute; inset-inline-end: max(-16rem, -22vw); inset-block-start: -7rem; inline-size: clamp(13rem, 27vw, 22rem); block-size: auto; fill: none; stroke: color-mix(in oklch, var(--hue) 58%, transparent); stroke-width: 1; opacity: 0.62; }
  .rings rect:nth-child(odd) { fill: color-mix(in oklch, var(--hue-soft) 24%, transparent); }
  .rings .core { fill: var(--v-teal); }
  .switches { display: block; inline-size: min(20rem, 100%); block-size: auto; margin-block-start: 1.75rem; fill: transparent; stroke: var(--line); stroke-width: 1; }
  .switches .on { fill: var(--hue-vivid); }
  [data-page='security']::before { background-image: var(--fortress-image); }
  [data-page='compare']::before { background-position: 60% center; }
  @media (max-width: 47.99rem) {
    .page-hero { min-block-size: 100svh; }
    .page-hero::before { background-position: 62% center; }
    .page-hero::after { background: linear-gradient(90deg, color-mix(in oklch, var(--ink) 94%, transparent), color-mix(in oklch, var(--ink) 56%, transparent)), linear-gradient(0deg, color-mix(in oklch, var(--ink) 94%, transparent), transparent 65%); }
    .page-hero-inner { padding-block: 8rem 4.5rem; }
    .page-hero h1 { font-size: clamp(2.75rem, 12vw, 3.2rem); }
    .rings { inline-size: 9rem; inset-inline-end: -4rem; inset-block-start: -5rem; }
  }
</style>
