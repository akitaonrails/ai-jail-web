---
import type { Hue } from '@/data/site';
interface Props { title: string; lede?: string; hue?: Hue; id?: string; tint?: boolean; narrow?: boolean; ink?: boolean }
const { title, lede, hue, id, tint, narrow, ink } = Astro.props;
---
<section id={id} data-hue={hue} class:list={['band section-manual scroll-mt-16', tint && 'bg-tint', ink && 'on-ink']}>
  <div class={narrow ? 'wrap-narrow' : 'wrap'}>
    <header class="section-heading">
      <h2 class="text-3xl max-w-[18em]">{title}</h2>
      {lede && <p class="lede" set:html={lede} />}
    </header>
    <div class="section-content"><slot /></div>
  </div>
</section>
<style is:global>
  .section-manual { border-block-start: 1px solid var(--line); }
  .section-heading { display: grid; gap: 1.5rem; border-inline-start: 0.25rem solid var(--hue-vivid, var(--line)); padding-inline-start: clamp(1rem, 3vw, 2rem); }
  .section-content { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
</style>
