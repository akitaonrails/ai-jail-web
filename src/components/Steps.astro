---
// A numbered procedure with terminal blocks. `text` accepts inline HTML.
import CodeBlock from './CodeBlock.astro';
interface Step { title: string; text?: string; code?: string; codeTitle?: string }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<ol class="grid gap-12" data-reveal="children">
  {steps.map((s, i) => (
    <li class="grid gap-5 md:grid-cols-[4rem_1fr]">
      <span class="font-display font-extrabold text-3xl leading-none" style="color:var(--hue-vivid)" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="grid gap-4">
        <h3 class="text-xl" set:html={s.title} />
        {s.text && <p class="text-muted max-w-[40em]" set:html={s.text} />}
        {s.code && <CodeBlock code={s.code} title={s.codeTitle} />}
      </div>
    </li>
  ))}
</ol>
