---
import CodeBlock from './CodeBlock.astro';
interface Step { title: string; text?: string; code?: string; codeTitle?: string }
interface Props { steps: Step[] }
import { useI18n } from '@/i18n';
const { steps } = Astro.props;
const { number } = useI18n(Astro);
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="step-index" style="color:var(--hue)" aria-hidden="true">{number(i + 1, { minimumIntegerDigits: 2, useGrouping: false })}</span>
      <div class="grid gap-4">
        <h3 class="text-xl" set:html={s.title} />
        {s.text && <p class="text-muted max-w-[40em]" set:html={s.text} />}
        {s.code && <CodeBlock code={s.code} title={s.codeTitle} />}
      </div>
    </li>
  ))}
</ol>
<style>
  .steps { border-block-start: 1px solid var(--line); }
  .steps > li { display: grid; gap: 1.25rem; padding-block: 2rem; border-block-end: 1px solid var(--line); }
  .step-index { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 700; line-height: 1; }
  @media (min-width: 48rem) { .steps > li { grid-template-columns: 4rem 1fr; gap: 1.5rem; } }
</style>
