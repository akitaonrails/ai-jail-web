---
// Accessible tabs. Panels are passed as slots named "0", "1", ... matching `labels`.
interface Props { labels: string[]; id: string }
import { useI18n } from '@/i18n';
const { t } = useI18n(Astro);
const { labels, id } = Astro.props;
---
<div data-tabs>
  <div role="tablist" class="tablist" aria-label={t('a11y.chooseOne')}>
    {labels.map((label, i) => (
      <button type="button" role="tab" id={`${id}-t${i}`} aria-controls={`${id}-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{label}</button>
    ))}
  </div>
  {labels.map((_, i) => (
    <div role="tabpanel" id={`${id}-p${i}`} aria-labelledby={`${id}-t${i}`} tabindex="0" class="mt-5"><slot name={String(i)} /></div>
  ))}
</div>
<style>
  .tablist { display: inline-flex; flex-wrap: wrap; border-block-start: 1px solid var(--line); border-inline-start: 1px solid var(--line); max-width: 100%; background: var(--surface); }
  [role='tab'] { padding: .55rem 1rem; border-inline-end: 1px solid var(--line); border-block-end: .2rem solid var(--line); font-weight: 600; font-size: .95rem; color: var(--muted); transition: background-color .15s, color .15s, border-color .15s; }
  [role='tab'][aria-selected='true'] { background: var(--hue-soft, var(--tint)); color: var(--hue, var(--text)); border-block-end-color: var(--hue-vivid, var(--text)); }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>(':scope > [role=tablist] > [role=tab]')];
    const select = (tab: HTMLElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
    };
    if (tabs[0]) select(tabs[0]);
    tabs.forEach((t) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(t);
        const rtl = getComputedStyle(t).direction === 'rtl';
        const d = e.key === 'ArrowRight' ? (rtl ? -1 : 1) : e.key === 'ArrowLeft' ? (rtl ? 1 : -1) : 0;
        const next = e.key === 'Home' ? tabs[0] : e.key === 'End' ? tabs.at(-1) : d ? tabs[(i + d + tabs.length) % tabs.length] : undefined;
        if (!next) return;
        e.preventDefault();
        select(next);
        next.focus();
      });
    });
  });
</script>
