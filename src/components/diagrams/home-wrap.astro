---
// Where the wall is: a built-in sandbox wraps only the shell commands; ai-jail wraps the whole agent.
import Box from './parts/Box.astro';
import Bars from './parts/Bars.astro';
import Chip from './parts/Chip.astro';
import Arrow from './parts/Arrow.astro';
import Note from './parts/Note.astro';
const { labels: L } = Astro.props as { labels: Record<string, string> };
---
<svg viewBox="0 0 800 380" xmlns="http://www.w3.org/2000/svg">
  {/* Left panel: the built-in sandbox */}
  <Note x={20} y={14} w={340} label={L['Built-in sandbox']} size="title" />
  <Chip x={60} y={70} w={100} label={L['Agent']} />
  <Box x={40} y={200} w={120} h={44} label={L['MCP servers']} kind="teal" />
  <Box x={40} y={258} w={120} h={44} label={L['Hooks']} kind="teal" />
  <Bars x={200} y={190} w={150} h={120} n={5} />
  <Box x={222} y={226} w={106} h={48} label={L['Shell commands']} kind="paper" />
  <Box x={210} y={70} w={130} h={64} label={L['Your home']} kind="optin" />
  <Arrow d="M165 116 L210 108" />
  <Arrow d="M160 222 L200 140" />
  <Arrow d="M160 280 L200 142" />
  <path d="M390 20 V360" class="dg-thin" style="stroke-dasharray:4 6" />
  {/* Right panel: ai-jail */}
  <Note x={430} y={14} w={340} label="ai-jail" size="title" />
  <Bars x={420} y={60} w={250} h={290} n={7} />
  <Chip x={460} y={95} w={100} label={L['Agent']} />
  <Box x={580} y={100} w={76} h={40} label={L['MCP servers']} kind="teal" size="small" />
  <Box x={580} y={150} w={76} h={40} label={L['Hooks']} kind="teal" size="small" />
  <Box x={470} y={215} w={94} h={48} label={L['Shell commands']} kind="paper" size="small" />
  <Box x={580} y={215} w={76} h={48} label={L['Project']} kind="teal" size="small" />
  <Arrow d="M520 200 L520 215" kind="line" />
  <Box x={700} y={170} w={80} h={64} label={L['Your home']} kind="blocked" size="small" />
  <Arrow d="M672 202 L690 202" kind="stopped" />
</svg>
