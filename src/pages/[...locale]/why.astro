---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Diagram from '@/components/Diagram.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Callout from '@/components/Callout.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Faq from '@/components/Faq.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import { faqPage, type Faq as FaqItem } from '@/lib/schema';
import { localePaths, useI18n, withText } from '@/i18n';
export const getStaticPaths = localePaths;

const { t, raw, href } = useI18n(Astro, 'why');
type Point = { title: string; text: string };
const faq = raw<FaqItem[]>('faq.items');
const scenarios = withText([{ hue: 'rose' }, { hue: 'red' }, { hue: 'clay' }] as const, raw<Point[]>('wrong.items'));
const next = withText([
  { href: '/how-it-works/', hue: 'clay' },
  { href: '/compare/', hue: 'teal' },
  { href: '/install/', hue: 'teal' },
] as const, raw<Point[]>('next'));
const cost = [
  'cd ~/Projects/my-app',
  t('cost.code.plain'),
  'ai-jail claude',
  t('cost.code.optin'),
  'ai-jail --allow-host api.example.com claude',
].join('\n');
// Day one: the switches people reach for in the first week, one terminal, comments from the catalog.
const dk = raw<string[]>('dayone.comments');
const dayone = [
  dk[0],
  'ai-jail --allow-host registry.npmjs.org claude',
  'ai-jail --network claude',
  '',
  dk[1],
  'ai-jail --forward-port 5432 claude',
  '',
  dk[2],
  'ai-jail --github claude',
  'ai-jail --network --ssh claude',
  '',
  dk[3],
  'ai-jail --docker claude',
  'ai-jail --display claude',
].join('\n');
---
<Base title={t('meta.title')} description={t('meta.description')} schema={[faqPage(faq)]}>
  <PageHero hue="rose" page="why" kicker={t('kicker.why')} title={t('hero.title')} lede={t('hero.lede')} audience={t('hero.audience')}>
    <a href={href('/install/')} class="btn btn-primary">{t('hero.install')}</a>
    <a href={href('/how-it-works/')} class="btn btn-ghost">{t('hero.how')}</a>
  </PageHero>

  <Section title={t('wrong.title')} lede={t('wrong.lede')} hue="red" tint>
    <FeatureGrid items={scenarios} />
    <Diagram name="why-injection" alt={t('wrong.alt')} caption={t('wrong.caption')} />
    <p class="mt-10 max-w-[40em] text-muted" set:html={t('wrong.note')} />
  </Section>

  <Section title={t('reach.title')} lede={t('reach.lede')} hue="rose" fill>
    <Diagram name="why-reach" alt={t('reach.alt')} caption={t('reach.caption')} />
    <h3 class="text-xl mb-5">{t('reach.listTitle')}</h3>
    <ul class="ticks md:grid-cols-2 md:gap-x-10 max-w-[64rem]">
      {raw<string[]>('reach.items').map((it) => <li set:html={it} />)}
    </ul>
  </Section>

  <Section title={t('prompts.title')} lede={t('prompts.lede')} hue="teal" narrow>
    <h3 class="text-xl mb-5">{t('prompts.listTitle')}</h3>
    <ul class="ticks" dir="auto">
      {raw<string[]>('prompts.items').map((it) => <li set:html={it} />)}
    </ul>
    <p class="mt-8 max-w-[40em]" set:html={t('prompts.text')} />
  </Section>

  <Section title={t('who.title')} lede={t('who.lede')} hue="rose" tint>
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      <div data-hue="rose">
        <span class="bars mb-4" aria-hidden="true"><i></i></span>
        <h3 class="text-xl mb-5">{t('who.needs.title')}</h3>
        <ul class="ticks">{raw<string[]>('who.needs.items').map((it) => <li set:html={it} />)}</ul>
      </div>
      <div data-hue="teal">
        <span class="bars mb-4" aria-hidden="true"><i></i></span>
        <h3 class="text-xl mb-5">{t('who.maynot.title')}</h3>
        <ul class="ticks">{raw<string[]>('who.maynot.items').map((it) => <li set:html={it} />)}</ul>
      </div>
    </div>
    <p class="mt-10 max-w-[40em] text-muted" set:html={t('who.note')} />
  </Section>

  <Section title={t('cost.title')} lede={t('cost.lede')} hue="mustard">
    <div class="grid gap-10 lg:grid-cols-2 items-start">
      <CodeBlock code={cost} title={t('cost.codeTitle')} />
      <Callout title={t('cost.honestTitle')} hue="mustard"><p set:html={t('cost.honest')} /></Callout>
    </div>
  </Section>

  <Section id="day-one" title={t('dayone.title')} lede={t('dayone.lede')} hue="teal" tint>
    <div class="grid gap-10 lg:grid-cols-2 items-start">
      <ul class="ticks">
        {raw<string[]>('dayone.items').map((it) => <li set:html={it} />)}
      </ul>
      <CodeBlock code={dayone} title={t('dayone.codeTitle')} />
    </div>
  </Section>

  <section class="wrap">
    <Callout title={t('approve.title')} hue="rose">
      <ul class="ticks">
        {raw<string[]>('approve.items').map((it) => <li set:html={it} />)}
      </ul>
    </Callout>
  </section>

  <Faq items={faq} title={t('faq.title')} hue="rose" />
  <NextPages title={t('next.title')} items={next} />
  <CtaBand />
</Base>
